
<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lottery Ticket Preview</title><style>
*{box-sizing:border-box}body{margin:0;background:#101827;color:#f8fafc;font-family:Arial,sans-serif;padding:18px}.wrap{max-width:1100px;margin:auto;display:grid;grid-template-columns:300px 1fr;gap:18px}.panel{background:#182235;border:1px solid #334155;border-radius:14px;padding:18px}.panel h2{margin:0 0 14px;font-size:20px;color:#fbbf24}label{display:block;font-size:13px;margin:12px 0 5px;color:#cbd5e1}input{width:100%;padding:11px;border-radius:8px;border:1px solid #475569;background:#0b1220;color:white;font-size:16px}button{width:100%;padding:12px;border:0;border-radius:8px;margin-top:12px;font-weight:bold;background:#10b981;color:#052e24;font-size:15px;cursor:pointer}.preview{min-width:0}.ticket{position:relative;width:100%;overflow:hidden;background:#fff}.ticket img{display:block;width:100%;height:auto;filter:none}.overlay{position:absolute;inset:0;pointer-events:none}.txt{position:absolute;color:#111827;font-weight:900;text-align:center;transform:translate(-50%,-50%);white-space:nowrap}.num{left:87.5%;top:23.5%;width:22%;font-family:Georgia,serif;font-size:clamp(12px,2.6vw,32px)}.price{left:45.2%;top:70%;color:#fff;font-size:clamp(9px,1.6vw,18px);transform:translate(-50%,-50%) rotate(-8deg);line-height:1.05;max-width:24%;white-space:nowrap}.date{left:47%;top:87.5%;color:#000;font-size:clamp(14px,2.5vw,28px);font-weight:900}.sample{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;transform:rotate(-24deg);font-size:clamp(18px,4vw,48px);font-weight:900;letter-spacing:2px;color:rgba(180,0,0,.38);text-shadow:1px 1px rgba(255,255,255,.7);white-space:nowrap}.note{font-size:12px;color:#cbd5e1;line-height:1.5;margin-top:12px}.bar{display:flex;gap:10px}.bar button{flex:1}.bar button.secondary{background:#334155;color:white}@media(max-width:760px){.wrap{grid-template-columns:1fr}body{padding:10px}.panel{order:1}.preview{order:2}}
</style></head><body><div class="wrap"><section class="panel"><h2>Ticket Preview</h2><label>Ticket number</label><input id="num" value="KL513178" maxlength="12"><label>Price (₹)</label><input id="price" type="number" value="49"><label>Draw date</label><input id="date" value="21-10-2026"><div class="bar"><button onclick="randomNum()">Random number</button><button class="secondary" onclick="resetFields()">Reset</button></div><button onclick="downloadPNG()">Download PNG</button></section><section class="preview"><div class="ticket" id="ticket"><img id="base" alt="Uploaded ticket "><div class="overlay"><div class="txt num" id="numOut">KL513178</div><div class="txt price" id="priceOut">₹49</div><div class="txt date" id="dateOut">21-10-2026</div><div class="sample"></div></div></div></section></div><script>
const imageSrc='data:image/jpeg;base64,';
const base=document.getElementById('base');base.src=imageSrc;
const num=document.getElementById('num'),price=document.getElementById('price'),date=document.getElementById('date');
function render(){document.getElementById('numOut').textContent=num.value.trim()||'KL513178';document.getElementById('priceOut').textContent='₹'+(price.value||'49');document.getElementById('dateOut').textContent=date.value.trim()||'21-10-2026'}
[num,price,date].forEach(x=>x.addEventListener('input',render));
function randomNum(){num.value='KL'+Math.floor(100000+Math.random()*900000);render()}
function resetFields(){num.value='KL513178';price.value='49';date.value='21-10-2026';render()}
function downloadPNG(){const img=new Image();img.onload=()=>{const c=document.createElement('canvas');c.width=img.naturalWidth;c.height=img.naturalHeight;const ctx=c.getContext('2d');ctx.drawImage(img,0,0);const sx=c.width/100,sy=c.height/100;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle='#111827';ctx.font='bold '+Math.round(c.width*.027)+'px Georgia';ctx.fillText(num.value.trim()||'KL513178',c.width*.875,c.height*.235);ctx.fillStyle='#fff';ctx.font='bold '+Math.round(c.width*.024)+'px Arial';ctx.fillText('₹'+(price.value||'49'),c.width*.452,c.height*.70);ctx.fillStyle='#000000';ctx.font='bold '+Math.round(c.width*.025)+'px Arial';ctx.fillText(date.value.trim()||'21-10-2026',c.width*.47,c.height*.875);ctx.save();ctx.translate(c.width/2,c.height/2);ctx.rotate(-Math.PI/7);ctx.textAlign='center';ctx.font='bold '+Math.round(c.width*.065)+'px Arial';ctx.lineWidth=Math.max(2,c.width*.003);ctx.strokeStyle='white';ctx.strokeText('',0,0);ctx.fillStyle='rgba(180,0,0,.82)';ctx.fillText('',0,0);ctx.restore();const a=document.createElement('a');a.download='ticket_sample_preview.png';a.href=c.toDataURL('image/png');a.click()};img.src=imageSrc}
render();</script></body></html>
